{
  "expo": {
    "name": "ATIRA",
    "slug": "atira",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.johnnycomins.atira",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow ATIRA to privately import activity from your paired Windows laptop on the same Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.johnnycomins.atira",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ATIRA to turn your location into a private timeline of places and journeys.",
          "locationAlwaysAndWhenInUsePermission": "Allow ATIRA to reconstruct places and journeys while you live your day.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-maps",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ATIRA to scan a one-time pairing QR code shown on your Windows laptop.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./modules/atira-healthkit/app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "94cb3706-f14a-4545-a9ad-1359e3d19ca7"
      }
    },
    "owner": "johnnycomins"
  }
}
